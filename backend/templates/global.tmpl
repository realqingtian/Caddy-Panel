{{define "global"}}{
	admin {{.Global.AdminBind}}
{{- if .Global.AcmeEmail}}
	email {{.Global.AcmeEmail}}
{{- end}}
{{- if .Global.ErrorLogPath}}
	log {
		output file {{.Global.ErrorLogPath}}
		level INFO
	}
{{- end}}
{{- if .Global.MetricsEnabled}}
	metrics
{{- end}}
{{- if .L4}}
	layer4 {
{{- range .L4}}
		{{.Network}}/{{.Listen}} {
			route {
				proxy {{join .Upstreams " "}}
			}
		}
{{- end}}
	}
{{- end}}
{{- if .Global.GlobalExtra}}
{{.Global.GlobalExtra}}
{{- end}}
}
{{end}}