{
	admin localhost:2019
	log {
		output file /data/logs/error.log
		level INFO
	}
	metrics
	layer4 {
		tcp/0.0.0.0:3306 {
			route {
				proxy 10.0.0.10:3306 10.0.0.11:3306
			}
		}
		udp/:5353 {
			route {
				proxy 10.0.0.53:53
			}
		}
	}
	servers {
		protocols h1 h2 h3
	}
}
app.example.com, www.example.com {
	log {
		output file /data/logs/access.log
	}
	reverse_proxy 127.0.0.1:8080 127.0.0.1:8081 {
		health_uri "/healthz"
		health_interval 10s
		health_status 200
		flush_interval -1
	}
	header X-Frame-Options "DENY"
	header X-Served-By "caddy \"panel\""
	@site_blocked remote_ip 192.168.1.1 10.0.0.0/8
	respond @site_blocked 403
	basic_auth {
		alice $2a$10$abcdefghij
	}
}
api.example.com {
	log {
		output file /data/logs/access.log
	}
	reverse_proxy 10.0.0.1:80 10.0.0.2:80 {
		lb_policy least_conn
	}
}
static.example.com {
	log {
		output file /data/logs/access.log
	}
	root * /var/www/static
	file_server
	@site_not_allowed not remote_ip 203.0.113.0/24
	respond @site_not_allowed 403
}
http://old.example.com {
	log {
		output file /data/logs/access.log
	}
	redir "https://new.example.com" permanent
}
