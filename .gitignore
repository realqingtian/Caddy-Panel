# OS
.DS_Store
Thumbs.db

# 本地工具产物
.video_agent/

# 运行数据与生成物
data/
backend/docs_swag/
backend/bin/

# Go
*.exe
*.test
*.out

# Node / Bun(node_modules 不入库,锁文件 bun.lock 必须入库)
node_modules/
frontend/dist/
*.local

